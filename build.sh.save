
#!/usr/bin/env bash
set -Eeuo pipefail

# Azure Container Registry configuration
REGISTRY="thangcontainerregistry"
IMAGE_NAME="task-service-bus"
DOCKERFILE="Docker/Dockerfile"

# Clean up the token when the script exits.
cleanup() {
  unset GITHUB_TOKEN
}
trap cleanup EXIT

# Verify prerequisites
if ! command -v az >/dev/null 2>&1; then
  echo "Error: Azure CLI (az) is not installed."
  exit 1
fi

if ! command -v git >/dev/null 2>&1; then
  echo "Error: Git is not installed."
  exit 1
fi

if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
  echo "Error: Run this script inside your Git repository."
  exit 1
fi

cd "$(git rev-parse --show-toplevel)"

if [[ ! -f "$DOCKERFILE" ]]; then
  echo "Error: Dockerfile not found: $DOCKERFILE"
  exit 1
fi

if ! az account show >/dev/null 2>&1; then
  echo "Please log in to Azure first: az login"
  exit 1
fi

# Use the current Git commit as the image tag.
COMMIT=$(git rev-parse --short HEAD)
IMAGE_TAG="sha-${COMMIT}"

# Prompt without displaying the token.
read -rsp "GitHub Packages token: " GITHUB_TOKEN
echo

if [[ -z "$GITHUB_TOKEN" ]]; then
  echo "Error: Token cannot be empty."
  exit 1
fi

echo "Building image: ${REGISTRY}.azurecr.io/${IMAGE_NAME}:${IMAGE_TAG}"

az acr build \
  --registry "$REGISTRY" \
  --image "${IMAGE_NAME}:${IMAGE_TAG}" \
  --file "$DOCKERFILE" \
  --secret-build-arg "GITHUB_TOKEN=${GITHUB_TOKEN}" \
  .

echo "Build completed successfully."
echo "Image: ${REGISTRY}.azurecr.io/${IMAGE_NAME}:${IMAGE_TAG}"


X
Exit

