{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sbemulatorns",
        "Topics": [
          {
            "Name": "tasks",
            "Subscriptions": [
              {
                "Name": "task-summary-worker",
                "MaxDeliveryCount": 3,
                "RequiresSession": true,
                "DeadLetteringOnMessageExpiration": false,
                "DefaultMessageTimeToLive": "PT1H"
              }
            ]
          }
        ]
      }
    ],
    "Logging": {
      "Type": "File"
    }
  }
}